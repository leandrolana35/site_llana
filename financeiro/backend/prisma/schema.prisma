generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTENTICAÇÃO E CONTROLE DE ACESSO
// ============================================================

model Usuario {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  senha         String
  ativo         Boolean   @default(true)
  superAdmin    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empresasUsuario EmpresaUsuario[]
  logs            LogAuditoria[]

  @@map("usuarios")
}

model Empresa {
  id                    String    @id @default(uuid())
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String    @unique
  inscricaoEstadual     String?
  inscricaoMunicipal    String?
  regimeTributario      RegimeTributario @default(SIMPLES_NACIONAL)
  tipoEmpresa           TipoEmpresa      @default(SERVICO)
  cnaePrincipal         String?
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  municipio             String?
  uf                    String    @default("SP")
  cep                   String?
  telefone              String?
  email                 String?
  site                  String?
  logo                  String?
  ativo                 Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Configurações de faturamento
  configFaturamento     ConfigFaturamento?
  // Configurações tributárias
  configTributaria      ConfigTributaria?

  empresasUsuario       EmpresaUsuario[]
  pessoas               Pessoa[]
  planoContas           PlanoContas[]
  centrosCusto          CentroCusto[]
  contasBancarias       ContaBancaria[]
  contasReceber         ContaReceber[]
  contasPagar           ContaPagar[]
  lancamentosRecorrentes LancamentoRecorrente[]
  notasFiscaisServico   NotaFiscalServico[]
  notasFiscaisProduto   NotaFiscalProduto[]
  conciliacoes          ConciliacaoBancaria[]
  logs                  LogAuditoria[]

  @@map("empresas")
}

model EmpresaUsuario {
  id        String   @id @default(uuid())
  empresaId String
  usuarioId String
  perfil    PerfilAcesso @default(OPERADOR)
  ativo     Boolean  @default(true)

  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([empresaId, usuarioId])
  @@map("empresa_usuarios")
}

// ============================================================
// CONFIGURAÇÕES
// ============================================================

model ConfigFaturamento {
  id                    String    @id @default(uuid())
  empresaId             String    @unique
  // NF-e
  emiteNFe              Boolean   @default(false)
  serieNFe              Int       @default(1)
  proximoNumeroNFe      Int       @default(1)
  ambienteNFe           AmbienteFiscal @default(HOMOLOGACAO)
  // NFS-e
  emiteNFSe             Boolean   @default(false)
  serieNFSe             String    @default("1")
  proximoNumeroNFSe     Int       @default(1)
  ambienteNFSe          AmbienteFiscal @default(HOMOLOGACAO)
  codigoMunicipioNFSe   String    @default("3550308") // São Paulo
  // NFC-e
  emiteNFCe             Boolean   @default(false)
  serieNFCe             Int       @default(1)
  proximoNumeroNFCe     Int       @default(1)
  // Boleto
  emiteBoleto           Boolean   @default(false)
  bancoBoletoCodigo     String?
  // Outras configs
  diasVencimentoPadrao  Int       @default(30)
  observacaoPadraoNFe   String?
  observacaoPadraoNFSe  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa   @relation(fields: [empresaId], references: [id])

  @@map("config_faturamento")
}

model ConfigTributaria {
  id                    String    @id @default(uuid())
  empresaId             String    @unique
  // Tributos atuais
  aliquotaIss           Decimal   @default(2.00)  @db.Decimal(5, 2)
  aliquotaPis           Decimal   @default(0.65)  @db.Decimal(5, 2)
  aliquotaCofins        Decimal   @default(3.00)  @db.Decimal(5, 2)
  aliquotaCsll          Decimal   @default(1.00)  @db.Decimal(5, 2)
  aliquotaIrpj          Decimal   @default(1.50)  @db.Decimal(5, 2)
  aliquotaInss          Decimal   @default(0.00)  @db.Decimal(5, 2)
  retIdContribuinte     Boolean   @default(false)
  // Reforma Tributária (vigência 2026+)
  preparadoReformaTrib  Boolean   @default(true)
  aliquotaCbs           Decimal   @default(0.00)  @db.Decimal(5, 2) // substitui PIS+COFINS
  aliquotaIbs           Decimal   @default(0.00)  @db.Decimal(5, 2) // substitui ICMS+ISS
  aliquotaIs            Decimal   @default(0.00)  @db.Decimal(5, 2) // Imposto Seletivo
  splitPayment          Boolean   @default(false)
  // Simples Nacional
  anexoSimples          AnexoSimples?
  faixaSimples          Int?
  aliquotaEfetivaSimples Decimal? @db.Decimal(5, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa   @relation(fields: [empresaId], references: [id])

  @@map("config_tributaria")
}

// ============================================================
// PESSOAS (PF e PJ) — CLIENTES, FORNECEDORES, ETC.
// ============================================================

model Pessoa {
  id                String    @id @default(uuid())
  empresaId         String
  tipo              TipoPessoa @default(JURIDICA)
  // PJ
  razaoSocial       String?
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  inscricaoMunicipal String?
  // PF
  nome              String?
  cpf               String?
  rg                String?
  dataNascimento    DateTime?
  // Contato
  email             String?
  telefone          String?
  celular           String?
  // Endereço
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?
  // Classificação
  cliente           Boolean   @default(false)
  fornecedor        Boolean   @default(false)
  funcionario       Boolean   @default(false)
  transportadora    Boolean   @default(false)
  // Financeiro
  limiteCredito     Decimal?  @db.Decimal(15, 2)
  diasPrazoPadrao   Int?
  observacao        String?
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  contasReceber     ContaReceber[]
  contasPagar       ContaPagar[]
  notasFiscaisServico NotaFiscalServico[]
  notasFiscaisProduto NotaFiscalProduto[]

  @@map("pessoas")
}

// ============================================================
// PLANO DE CONTAS
// ============================================================

model PlanoContas {
  id          String    @id @default(uuid())
  empresaId   String
  codigo      String
  descricao   String
  tipo        TipoContaContabil @default(DESPESA)
  natureza    NaturezaConta     @default(CREDORA)
  nivel       Int       @default(1)
  aceitaLancamento Boolean @default(true)
  contaPaiId  String?
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  contaPai    PlanoContas? @relation("PlanoHierarquia", fields: [contaPaiId], references: [id])
  contasFilhas PlanoContas[] @relation("PlanoHierarquia")
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]

  @@unique([empresaId, codigo])
  @@map("plano_contas")
}

// ============================================================
// CENTROS DE CUSTO
// ============================================================

model CentroCusto {
  id          String    @id @default(uuid())
  empresaId   String
  codigo      String
  descricao   String
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]

  @@unique([empresaId, codigo])
  @@map("centros_custo")
}

// ============================================================
// CONTAS BANCÁRIAS
// ============================================================

model ContaBancaria {
  id              String    @id @default(uuid())
  empresaId       String
  descricao       String
  banco           String?
  codigoBanco     String?
  agencia         String?
  conta           String?
  tipoConta       TipoConta @default(CORRENTE)
  saldoInicial    Decimal   @default(0) @db.Decimal(15, 2)
  saldoAtual      Decimal   @default(0) @db.Decimal(15, 2)
  dataAbertura    DateTime?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  contasReceber   ContaReceber[]
  contasPagar     ContaPagar[]
  conciliacoes    ConciliacaoBancaria[]
  extratos        ExtratoBancario[]

  @@map("contas_bancarias")
}

// ============================================================
// CONTAS A RECEBER
// ============================================================

model ContaReceber {
  id                  String    @id @default(uuid())
  empresaId           String
  pessoaId            String?
  planoContasId       String?
  centroCustoId       String?
  contaBancariaId     String?
  // Origem
  origem              OrigemLancamento @default(AVULSO)
  notaFiscalServicoId String?
  notaFiscalProdutoId String?
  lancamentoRecorrenteId String?
  // Dados
  descricao           String
  numeroDocumento     String?
  competencia         DateTime
  dataEmissao         DateTime  @default(now())
  dataVencimento      DateTime
  dataPagamento       DateTime?
  valor               Decimal   @db.Decimal(15, 2)
  valorDesconto       Decimal   @default(0) @db.Decimal(15, 2)
  valorJuros          Decimal   @default(0) @db.Decimal(15, 2)
  valorMulta          Decimal   @default(0) @db.Decimal(15, 2)
  valorPago           Decimal?  @db.Decimal(15, 2)
  status              StatusLancamento @default(ABERTO)
  // Parcelas
  parcela             Int?
  totalParcelas       Int?
  // Conciliação
  conciliado          Boolean   @default(false)
  dataConciliacao     DateTime?
  extratoId           String?
  observacao          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empresa             Empresa        @relation(fields: [empresaId], references: [id])
  pessoa              Pessoa?        @relation(fields: [pessoaId], references: [id])
  planoContas         PlanoContas?   @relation(fields: [planoContasId], references: [id])
  centroCusto         CentroCusto?   @relation(fields: [centroCustoId], references: [id])
  contaBancaria       ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  notaFiscalServico   NotaFiscalServico? @relation(fields: [notaFiscalServicoId], references: [id])
  notaFiscalProduto   NotaFiscalProduto? @relation(fields: [notaFiscalProdutoId], references: [id])
  lancamentoRecorrente LancamentoRecorrente? @relation(fields: [lancamentoRecorrenteId], references: [id])
  extrato             ExtratoBancario? @relation(fields: [extratoId], references: [id])

  @@map("contas_receber")
}

// ============================================================
// CONTAS A PAGAR
// ============================================================

model ContaPagar {
  id                  String    @id @default(uuid())
  empresaId           String
  pessoaId            String?
  planoContasId       String?
  centroCustoId       String?
  contaBancariaId     String?
  // Origem
  origem              OrigemLancamento @default(AVULSO)
  lancamentoRecorrenteId String?
  // Dados
  descricao           String
  numeroDocumento     String?
  competencia         DateTime
  dataEmissao         DateTime  @default(now())
  dataVencimento      DateTime
  dataPagamento       DateTime?
  valor               Decimal   @db.Decimal(15, 2)
  valorDesconto       Decimal   @default(0) @db.Decimal(15, 2)
  valorJuros          Decimal   @default(0) @db.Decimal(15, 2)
  valorMulta          Decimal   @default(0) @db.Decimal(15, 2)
  valorPago           Decimal?  @db.Decimal(15, 2)
  status              StatusLancamento @default(ABERTO)
  // Parcelas
  parcela             Int?
  totalParcelas       Int?
  // Conciliação
  conciliado          Boolean   @default(false)
  dataConciliacao     DateTime?
  extratoId           String?
  observacao          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empresa             Empresa        @relation(fields: [empresaId], references: [id])
  pessoa              Pessoa?        @relation(fields: [pessoaId], references: [id])
  planoContas         PlanoContas?   @relation(fields: [planoContasId], references: [id])
  centroCusto         CentroCusto?   @relation(fields: [centroCustoId], references: [id])
  contaBancaria       ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  lancamentoRecorrente LancamentoRecorrente? @relation(fields: [lancamentoRecorrenteId], references: [id])
  extrato             ExtratoBancario? @relation(fields: [extratoId], references: [id])

  @@map("contas_pagar")
}

// ============================================================
// LANÇAMENTOS RECORRENTES
// ============================================================

model LancamentoRecorrente {
  id                String    @id @default(uuid())
  empresaId         String
  tipo              TipoLancamento @default(PAGAR)
  descricao         String
  valor             Decimal   @db.Decimal(15, 2)
  periodicidade     Periodicidade @default(MENSAL)
  diaVencimento     Int
  dataInicio        DateTime
  dataFim           DateTime?
  totalOcorrencias  Int?
  ocorrenciasGeradas Int      @default(0)
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa           Empresa       @relation(fields: [empresaId], references: [id])
  contasReceber     ContaReceber[]
  contasPagar       ContaPagar[]

  @@map("lancamentos_recorrentes")
}

// ============================================================
// NOTAS FISCAIS DE SERVIÇO (NFS-e)
// ============================================================

model NotaFiscalServico {
  id                    String    @id @default(uuid())
  empresaId             String
  pessoaId              String
  numero                Int
  serie                 String    @default("1")
  status                StatusNota @default(RASCUNHO)
  ambiente              AmbienteFiscal @default(HOMOLOGACAO)
  // Datas
  dataEmissao           DateTime  @default(now())
  dataCompetencia       DateTime
  // Serviço
  discriminacao         String
  codigoServico         String?
  codigoCnae            String?
  itemListaServico      String?
  // Valores
  valorServico          Decimal   @db.Decimal(15, 2)
  deducoes              Decimal   @default(0) @db.Decimal(15, 2)
  baseCalculo           Decimal   @db.Decimal(15, 2)
  // Tributos - Sistema Atual
  aliquotaIss           Decimal   @default(0) @db.Decimal(5, 2)
  valorIss              Decimal   @default(0) @db.Decimal(15, 2)
  retidoFonte           Boolean   @default(false)
  aliquotaPis           Decimal   @default(0) @db.Decimal(5, 2)
  valorPis              Decimal   @default(0) @db.Decimal(15, 2)
  aliquotaCofins        Decimal   @default(0) @db.Decimal(5, 2)
  valorCofins           Decimal   @default(0) @db.Decimal(15, 2)
  aliquotaCsll          Decimal   @default(0) @db.Decimal(5, 2)
  valorCsll             Decimal   @default(0) @db.Decimal(15, 2)
  aliquotaIr            Decimal   @default(0) @db.Decimal(5, 2)
  valorIr               Decimal   @default(0) @db.Decimal(15, 2)
  aliquotaInss          Decimal   @default(0) @db.Decimal(5, 2)
  valorInss             Decimal   @default(0) @db.Decimal(15, 2)
  // Tributos - Reforma Tributária
  aliquotaCbs           Decimal   @default(0) @db.Decimal(5, 2)
  valorCbs              Decimal   @default(0) @db.Decimal(15, 2)
  aliquotaIbs           Decimal   @default(0) @db.Decimal(5, 2)
  valorIbs              Decimal   @default(0) @db.Decimal(15, 2)
  splitPayment          Boolean   @default(false)
  // Valor líquido
  valorLiquido          Decimal   @db.Decimal(15, 2)
  // Retorno Sefaz/Prefeitura
  chaveAcesso           String?
  codigoVerificacao     String?
  numeroRps             String?
  xmlEnvio              String?   @db.Text
  xmlRetorno            String?   @db.Text
  pdfUrl                String?
  motivoCancelamento    String?
  dataCancelamento      DateTime?
  observacao            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa       @relation(fields: [empresaId], references: [id])
  pessoa                Pessoa        @relation(fields: [pessoaId], references: [id])
  contasReceber         ContaReceber[]

  @@map("notas_fiscais_servico")
}

// ============================================================
// NOTAS FISCAIS DE PRODUTO (NF-e)
// ============================================================

model NotaFiscalProduto {
  id                    String    @id @default(uuid())
  empresaId             String
  pessoaId              String
  numero                Int
  serie                 Int       @default(1)
  naturezaOperacao      String    @default("Venda de Mercadorias")
  tipoOperacao          TipoOperacaoNFe @default(SAIDA)
  finalidade            FinalidadeNFe   @default(NORMAL)
  status                StatusNota      @default(RASCUNHO)
  ambiente              AmbienteFiscal  @default(HOMOLOGACAO)
  // Datas
  dataEmissao           DateTime  @default(now())
  dataSaida             DateTime?
  // Valores
  valorProdutos         Decimal   @db.Decimal(15, 2)
  valorFrete            Decimal   @default(0) @db.Decimal(15, 2)
  valorSeguro           Decimal   @default(0) @db.Decimal(15, 2)
  valorDesconto         Decimal   @default(0) @db.Decimal(15, 2)
  valorOutros           Decimal   @default(0) @db.Decimal(15, 2)
  valorIpi              Decimal   @default(0) @db.Decimal(15, 2)
  valorIcms             Decimal   @default(0) @db.Decimal(15, 2)
  valorPis              Decimal   @default(0) @db.Decimal(15, 2)
  valorCofins           Decimal   @default(0) @db.Decimal(15, 2)
  // Reforma Tributária
  valorCbs              Decimal   @default(0) @db.Decimal(15, 2)
  valorIbs              Decimal   @default(0) @db.Decimal(15, 2)
  splitPayment          Boolean   @default(false)
  valorTotal            Decimal   @db.Decimal(15, 2)
  // Retorno Sefaz
  chaveAcesso           String?   @unique
  protocolo             String?
  xmlEnvio              String?   @db.Text
  xmlRetorno            String?   @db.Text
  pdfUrl                String?
  motivoCancelamento    String?
  dataCancelamento      DateTime?
  informacoesAdicionais String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa       @relation(fields: [empresaId], references: [id])
  pessoa                Pessoa        @relation(fields: [pessoaId], references: [id])
  itens                 ItemNFe[]
  contasReceber         ContaReceber[]

  @@map("notas_fiscais_produto")
}

model ItemNFe {
  id                    String    @id @default(uuid())
  notaFiscalProdutoId   String
  ordem                 Int
  codigo                String?
  descricao             String
  ncm                   String?
  cfop                  String?
  unidade               String    @default("UN")
  quantidade            Decimal   @db.Decimal(15, 4)
  valorUnitario         Decimal   @db.Decimal(15, 4)
  valorTotal            Decimal   @db.Decimal(15, 2)
  // ICMS
  cstIcms               String?
  aliquotaIcms          Decimal   @default(0) @db.Decimal(5, 2)
  valorIcms             Decimal   @default(0) @db.Decimal(15, 2)
  // IPI
  cstIpi                String?
  aliquotaIpi           Decimal   @default(0) @db.Decimal(5, 2)
  valorIpi              Decimal   @default(0) @db.Decimal(15, 2)
  // PIS/COFINS
  cstPis                String?
  aliquotaPis           Decimal   @default(0) @db.Decimal(5, 2)
  valorPis              Decimal   @default(0) @db.Decimal(15, 2)
  cstCofins             String?
  aliquotaCofins        Decimal   @default(0) @db.Decimal(5, 2)
  valorCofins           Decimal   @default(0) @db.Decimal(15, 2)
  // Reforma Tributária
  aliquotaCbs           Decimal   @default(0) @db.Decimal(5, 2)
  valorCbs              Decimal   @default(0) @db.Decimal(15, 2)
  aliquotaIbs           Decimal   @default(0) @db.Decimal(5, 2)
  valorIbs              Decimal   @default(0) @db.Decimal(15, 2)

  notaFiscal            NotaFiscalProduto @relation(fields: [notaFiscalProdutoId], references: [id], onDelete: Cascade)

  @@map("itens_nfe")
}

// ============================================================
// CONCILIAÇÃO BANCÁRIA
// ============================================================

model ConciliacaoBancaria {
  id              String    @id @default(uuid())
  empresaId       String
  contaBancariaId String
  descricao       String
  dataInicio      DateTime
  dataFim         DateTime
  saldoInicial    Decimal   @db.Decimal(15, 2)
  saldoFinal      Decimal   @db.Decimal(15, 2)
  status          StatusConciliacao @default(EM_ANDAMENTO)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresa         Empresa       @relation(fields: [empresaId], references: [id])
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])
  extratos        ExtratoBancario[]

  @@map("conciliacoes_bancarias")
}

model ExtratoBancario {
  id                  String    @id @default(uuid())
  conciliacaoId       String?
  contaBancariaId     String
  data                DateTime
  historico           String
  documento           String?
  valor               Decimal   @db.Decimal(15, 2)
  tipo                TipoMovimento @default(CREDITO)
  saldoAposMovimento  Decimal?  @db.Decimal(15, 2)
  conciliado          Boolean   @default(false)
  createdAt           DateTime  @default(now())

  conciliacao         ConciliacaoBancaria? @relation(fields: [conciliacaoId], references: [id])
  contaBancaria       ContaBancaria        @relation(fields: [contaBancariaId], references: [id])
  contasReceber       ContaReceber[]
  contasPagar         ContaPagar[]

  @@map("extratos_bancarios")
}

// ============================================================
// LOG DE AUDITORIA
// ============================================================

model LogAuditoria {
  id          String    @id @default(uuid())
  empresaId   String?
  usuarioId   String?
  entidade    String
  entidadeId  String?
  acao        String
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  createdAt   DateTime  @default(now())

  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@map("logs_auditoria")
}

// ============================================================
// ENUMS
// ============================================================

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum TipoEmpresa {
  SERVICO
  COMERCIO
  INDUSTRIA
  MISTO
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum PerfilAcesso {
  ADMIN
  GERENTE
  OPERADOR
  VISUALIZADOR
}

enum TipoContaContabil {
  ATIVO
  PASSIVO
  PATRIMONIO
  RECEITA
  DESPESA
  CUSTOS
}

enum NaturezaConta {
  DEVEDORA
  CREDORA
}

enum TipoConta {
  CORRENTE
  POUPANCA
  INVESTIMENTO
