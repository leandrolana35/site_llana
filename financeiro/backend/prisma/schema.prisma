generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  senha         String
  ativo         Boolean   @default(true)
  superAdmin    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empresasUsuario EmpresaUsuario[]
  logs            LogAuditoria[]

  @@map("usuarios")
}

model Empresa {
  id                    String    @id @default(uuid())
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String    @unique
  inscricaoEstadual     String?
  inscricaoMunicipal    String?
  regimeTributario      String    @default("SIMPLES_NACIONAL")
  tipoEmpresa           String    @default("SERVICO")
  cnaePrincipal         String?
  logradouro            String?
  numero                String?
  complemento           String?
  bairro                String?
  municipio             String?
  uf                    String    @default("SP")
  cep                   String?
  telefone              String?
  email                 String?
  site                  String?
  logo                  String?
  ativo                 Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  configFaturamento     ConfigFaturamento?
  configTributaria      ConfigTributaria?
  empresasUsuario       EmpresaUsuario[]
  pessoas               Pessoa[]
  planoContas           PlanoContas[]
  centrosCusto          CentroCusto[]
  contasBancarias       ContaBancaria[]
  contasReceber         ContaReceber[]
  contasPagar           ContaPagar[]
  lancamentosRecorrentes LancamentoRecorrente[]
  notasFiscaisServico   NotaFiscalServico[]
  notasFiscaisProduto   NotaFiscalProduto[]
  conciliacoes          ConciliacaoBancaria[]
  logs                  LogAuditoria[]

  @@map("empresas")
}

model EmpresaUsuario {
  id        String   @id @default(uuid())
  empresaId String
  usuarioId String
  perfil    String   @default("OPERADOR")
  ativo     Boolean  @default(true)

  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([empresaId, usuarioId])
  @@map("empresa_usuarios")
}

model ConfigFaturamento {
  id                    String    @id @default(uuid())
  empresaId             String    @unique
  emiteNFe              Boolean   @default(false)
  serieNFe              Int       @default(1)
  proximoNumeroNFe      Int       @default(1)
  ambienteNFe           String    @default("HOMOLOGACAO")
  emiteNFSe             Boolean   @default(false)
  serieNFSe             String    @default("1")
  proximoNumeroNFSe     Int       @default(1)
  ambienteNFSe          String    @default("HOMOLOGACAO")
  codigoMunicipioNFSe   String    @default("3550308")
  emiteNFCe             Boolean   @default(false)
  serieNFCe             Int       @default(1)
  proximoNumeroNFCe     Int       @default(1)
  emiteBoleto           Boolean   @default(false)
  bancoBoletoCodigo     String?
  diasVencimentoPadrao  Int       @default(30)
  observacaoPadraoNFe   String?
  observacaoPadraoNFSe  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa   @relation(fields: [empresaId], references: [id])

  @@map("config_faturamento")
}

model ConfigTributaria {
  id                    String    @id @default(uuid())
  empresaId             String    @unique
  aliquotaIss           Decimal   @default(2.00)
  aliquotaPis           Decimal   @default(0.65)
  aliquotaCofins        Decimal   @default(3.00)
  aliquotaCsll          Decimal   @default(1.00)
  aliquotaIrpj          Decimal   @default(1.50)
  aliquotaInss          Decimal   @default(0.00)
  retIdContribuinte     Boolean   @default(false)
  preparadoReformaTrib  Boolean   @default(true)
  aliquotaCbs           Decimal   @default(0.00)
  aliquotaIbs           Decimal   @default(0.00)
  aliquotaIs            Decimal   @default(0.00)
  splitPayment          Boolean   @default(false)
  anexoSimples          String?
  faixaSimples          Int?
  aliquotaEfetivaSimples Decimal?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa   @relation(fields: [empresaId], references: [id])

  @@map("config_tributaria")
}

model Pessoa {
  id                String    @id @default(uuid())
  empresaId         String
  tipo              String    @default("JURIDICA")
  razaoSocial       String?
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  inscricaoMunicipal String?
  nome              String?
  cpf               String?
  rg                String?
  dataNascimento    DateTime?
  email             String?
  telefone          String?
  celular           String?
  cep               String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  uf                String?
  cliente           Boolean   @default(false)
  fornecedor        Boolean   @default(false)
  funcionario       Boolean   @default(false)
  transportadora    Boolean   @default(false)
  limiteCredito     Decimal?
  diasPrazoPadrao   Int?
  observacao        String?
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  contasReceber     ContaReceber[]
  contasPagar       ContaPagar[]
  notasFiscaisServico NotaFiscalServico[]
  notasFiscaisProduto NotaFiscalProduto[]

  @@map("pessoas")
}

model PlanoContas {
  id          String    @id @default(uuid())
  empresaId   String
  codigo      String
  descricao   String
  tipo        String    @default("DESPESA")
  natureza    String    @default("CREDORA")
  nivel       Int       @default(1)
  aceitaLancamento Boolean @default(true)
  contaPaiId  String?
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  contaPai    PlanoContas? @relation("PlanoHierarquia", fields: [contaPaiId], references: [id])
  contasFilhas PlanoContas[] @relation("PlanoHierarquia")
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]

  @@unique([empresaId, codigo])
  @@map("plano_contas")
}

model CentroCusto {
  id          String    @id @default(uuid())
  empresaId   String
  codigo      String
  descricao   String
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]

  @@unique([empresaId, codigo])
  @@map("centros_custo")
}

model ContaBancaria {
  id              String    @id @default(uuid())
  empresaId       String
  descricao       String
  banco           String?
  codigoBanco     String?
  agencia         String?
  conta           String?
  tipoConta       String    @default("CORRENTE")
  saldoInicial    Decimal   @default(0)
  saldoAtual      Decimal   @default(0)
  dataAbertura    DateTime?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  contasReceber   ContaReceber[]
  contasPagar     ContaPagar[]
  conciliacoes    ConciliacaoBancaria[]
  extratos        ExtratoBancario[]

  @@map("contas_bancarias")
}

model ContaReceber {
  id                  String    @id @default(uuid())
  empresaId           String
  pessoaId            String?
  planoContasId       String?
  centroCustoId       String?
  contaBancariaId     String?
  origem              String    @default("AVULSO")
  notaFiscalServicoId String?
  notaFiscalProdutoId String?
  lancamentoRecorrenteId String?
  descricao           String
  numeroDocumento     String?
  competencia         DateTime
  dataEmissao         DateTime  @default(now())
  dataVencimento      DateTime
  dataPagamento       DateTime?
  valor               Decimal
  valorDesconto       Decimal   @default(0)
  valorJuros          Decimal   @default(0)
  valorMulta          Decimal   @default(0)
  valorPago           Decimal?
  status              String    @default("ABERTO")
  parcela             Int?
  totalParcelas       Int?
  conciliado          Boolean   @default(false)
  dataConciliacao     DateTime?
  extratoId           String?
  observacao          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empresa             Empresa        @relation(fields: [empresaId], references: [id])
  pessoa              Pessoa?        @relation(fields: [pessoaId], references: [id])
  planoContas         PlanoContas?   @relation(fields: [planoContasId], references: [id])
  centroCusto         CentroCusto?   @relation(fields: [centroCustoId], references: [id])
  contaBancaria       ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  notaFiscalServico   NotaFiscalServico? @relation(fields: [notaFiscalServicoId], references: [id])
  notaFiscalProduto   NotaFiscalProduto? @relation(fields: [notaFiscalProdutoId], references: [id])
  lancamentoRecorrente LancamentoRecorrente? @relation(fields: [lancamentoRecorrenteId], references: [id])
  extrato             ExtratoBancario? @relation(fields: [extratoId], references: [id])

  @@map("contas_receber")
}

model ContaPagar {
  id                  String    @id @default(uuid())
  empresaId           String
  pessoaId            String?
  planoContasId       String?
  centroCustoId       String?
  contaBancariaId     String?
  origem              String    @default("AVULSO")
  lancamentoRecorrenteId String?
  descricao           String
  numeroDocumento     String?
  competencia         DateTime
  dataEmissao         DateTime  @default(now())
  dataVencimento      DateTime
  dataPagamento       DateTime?
  valor               Decimal
  valorDesconto       Decimal   @default(0)
  valorJuros          Decimal   @default(0)
  valorMulta          Decimal   @default(0)
  valorPago           Decimal?
  status              String    @default("ABERTO")
  parcela             Int?
  totalParcelas       Int?
  conciliado          Boolean   @default(false)
  dataConciliacao     DateTime?
  extratoId           String?
  observacao          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empresa             Empresa        @relation(fields: [empresaId], references: [id])
  pessoa              Pessoa?        @relation(fields: [pessoaId], references: [id])
  planoContas         PlanoContas?   @relation(fields: [planoContasId], references: [id])
  centroCusto         CentroCusto?   @relation(fields: [centroCustoId], references: [id])
  contaBancaria       ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  lancamentoRecorrente LancamentoRecorrente? @relation(fields: [lancamentoRecorrenteId], references: [id])
  extrato             ExtratoBancario? @relation(fields: [extratoId], references: [id])

  @@map("contas_pagar")
}

model LancamentoRecorrente {
  id                String    @id @default(uuid())
  empresaId         String
  tipo              String    @default("PAGAR")
  descricao         String
  valor             Decimal
  periodicidade     String    @default("MENSAL")
  diaVencimento     Int
  dataInicio        DateTime
  dataFim           DateTime?
  totalOcorrencias  Int?
  ocorrenciasGeradas Int      @default(0)
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa           Empresa       @relation(fields: [empresaId], references: [id])
  contasReceber     ContaReceber[]
  contasPagar       ContaPagar[]

  @@map("lancamentos_recorrentes")
}

model NotaFiscalServico {
  id                    String    @id @default(uuid())
  empresaId             String
  pessoaId              String
  numero                Int
  serie                 String    @default("1")
  status                String    @default("RASCUNHO")
  ambiente              String    @default("HOMOLOGACAO")
  dataEmissao           DateTime  @default(now())
  dataCompetencia       DateTime
  discriminacao         String
  codigoServico         String?
  codigoCnae            String?
  itemListaServico      String?
  valorServico          Decimal
  deducoes              Decimal   @default(0)
  baseCalculo           Decimal
  aliquotaIss           Decimal   @default(0)
  valorIss              Decimal   @default(0)
  retidoFonte           Boolean   @default(false)
  aliquotaPis           Decimal   @default(0)
  valorPis              Decimal   @default(0)
  aliquotaCofins        Decimal   @default(0)
  valorCofins           Decimal   @default(0)
  aliquotaCsll          Decimal   @default(0)
  valorCsll             Decimal   @default(0)
  aliquotaIr            Decimal   @default(0)
  valorIr               Decimal   @default(0)
  aliquotaInss          Decimal   @default(0)
  valorInss             Decimal   @default(0)
  aliquotaCbs           Decimal   @default(0)
  valorCbs              Decimal   @default(0)
  aliquotaIbs           Decimal   @default(0)
  valorIbs              Decimal   @default(0)
  splitPayment          Boolean   @default(false)
  valorLiquido          Decimal
  chaveAcesso           String?
  codigoVerificacao     String?
  numeroRps             String?
  xmlEnvio              String?
  xmlRetorno            String?
  pdfUrl                String?
  motivoCancelamento    String?
  dataCancelamento      DateTime?
  observacao            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa       @relation(fields: [empresaId], references: [id])
  pessoa                Pessoa        @relation(fields: [pessoaId], references: [id])
  contasReceber         ContaReceber[]

  @@map("notas_fiscais_servico")
}

model NotaFiscalProduto {
  id                    String    @id @default(uuid())
  empresaId             String
  pessoaId              String
  numero                Int
  serie                 Int       @default(1)
  naturezaOperacao      String    @default("Venda de Mercadorias")
  tipoOperacao          String    @default("SAIDA")
  finalidade            String    @default("NORMAL")
  status                String    @default("RASCUNHO")
  ambiente              String    @default("HOMOLOGACAO")
  dataEmissao           DateTime  @default(now())
  dataSaida             DateTime?
  valorProdutos         Decimal
  valorFrete            Decimal   @default(0)
  valorSeguro           Decimal   @default(0)
  valorDesconto         Decimal   @default(0)
  valorOutros           Decimal   @default(0)
  valorIpi              Decimal   @default(0)
  valorIcms             Decimal   @default(0)
  valorPis              Decimal   @default(0)
  valorCofins           Decimal   @default(0)
  valorCbs              Decimal   @default(0)
  valorIbs              Decimal   @default(0)
  splitPayment          Boolean   @default(false)
  valorTotal            Decimal
  chaveAcesso           String?   @unique
  protocolo             String?
  xmlEnvio              String?
  xmlRetorno            String?
  pdfUrl                String?
  motivoCancelamento    String?
  dataCancelamento      DateTime?
  informacoesAdicionais String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  empresa               Empresa       @relation(fields: [empresaId], references: [id])
  pessoa                Pessoa        @relation(fields: [pessoaId], references: [id])
  itens                 ItemNFe[]
  contasReceber         ContaReceber[]

  @@map("notas_fiscais_produto")
}

model ItemNFe {
  id                    String    @id @default(uuid())
  notaFiscalProdutoId   String
  ordem                 Int
  codigo                String?
  descricao             String
  ncm                   String?
  cfop                  String?
  unidade               String    @default("UN")
  quantidade            Decimal
  valorUnitario         Decimal
  valorTotal            Decimal
  cstIcms               String?
  aliquotaIcms          Decimal   @default(0)
  valorIcms             Decimal   @default(0)
  cstIpi                String?
  aliquotaIpi           Decimal   @default(0)
  valorIpi              Decimal   @default(0)
  cstPis                String?
  aliquotaPis           Decimal   @default(0)
  valorPis              Decimal   @default(0)
  cstCofins             String?
  aliquotaCofins        Decimal   @default(0)
  valorCofins           Decimal   @default(0)
  aliquotaCbs           Decimal   @default(0)
  valorCbs              Decimal   @default(0)
  aliquotaIbs           Decimal   @default(0)
  valorIbs              Decimal   @default(0)

  notaFiscal            NotaFiscalProduto @relation(fields: [notaFiscalProdutoId], references: [id], onDelete: Cascade)

  @@map("itens_nfe")
}

model ConciliacaoBancaria {
  id              String    @id @default(uuid())
  empresaId       String
  contaBancariaId String
  descricao       String
  dataInicio      DateTime
  dataFim         DateTime
  saldoInicial    Decimal
  saldoFinal      Decimal
  status          String    @default("EM_ANDAMENTO")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresa         Empresa       @relation(fields: [empresaId], references: [id])
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])
  extratos        ExtratoBancario[]

  @@map("conciliacoes_bancarias")
}

model ExtratoBancario {
  id                  String    @id @default(uuid())
  conciliacaoId       String?
  contaBancariaId     String
  data                DateTime
  historico           String
  documento           String?
  valor               Decimal
  tipo                String    @default("CREDITO")
  saldoAposMovimento  Decimal?
  conciliado          Boolean   @default(false)
  createdAt           DateTime  @default(now())

  conciliacao         ConciliacaoBancaria? @relation(fields: [conciliacaoId], references: [id])
  contaBancaria       ContaBancaria        @relation(fields: [contaBancariaId], references: [id])
  contasReceber       ContaReceber[]
  contasPagar         ContaPagar[]

  @@map("extratos_bancarios")
}

model LogAuditoria {
  id          String    @id @default(uuid())
  empresaId   String?
  usuarioId   String?
  entidade    String
  entidadeId  String?
  acao        String
  dadosAntes  String?
  dadosDepois String?
  ip          String?
  createdAt   DateTime  @default(now())

  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@map("logs_auditoria")
}
